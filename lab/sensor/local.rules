# Lớp 1 (mục 7.1): luật threshold bắt nhanh các flood đơn giản; cũng là baseline "chỉ dùng Suricata" cho E6.
alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible SYN flood"; flags:S; flow:stateless; threshold: type both, track by_dst, count 500, seconds 1; classtype:attempted-dos; sid:1000001; rev:1;)
alert udp any any -> $HOME_NET any (msg:"LOCAL Possible UDP flood"; threshold: type both, track by_dst, count 1000, seconds 1; classtype:attempted-dos; sid:1000002; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"LOCAL Possible ICMP flood"; itype:8; threshold: type both, track by_dst, count 500, seconds 1; classtype:attempted-dos; sid:1000003; rev:1;)
